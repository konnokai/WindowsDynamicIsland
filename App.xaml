<Application
    x:Class="WindowsDynamicIsland.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="IslandPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="IslandSecondaryBrush" Color="#FF9A9AA1" />
            <SolidColorBrush x:Key="IslandMutedBrush" Color="#FF5C5C63" />
            <Style x:Key="IslandIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource IslandPrimaryBrush}" />
                <Setter Property="Background" Value="#FF242429" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
            <Style x:Key="QuestionOptionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource IslandPrimaryBrush}" />
                <Setter Property="Background" Value="#FF242429" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
