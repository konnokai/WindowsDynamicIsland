<Window
    x:Class="WindowsDynamicIsland.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="IslandRoot" Background="Transparent" Loaded="OnWindowLoaded">
        <Border
            x:Name="IslandSurface"
            Background="{StaticResource IslandBackgroundBrush}"
            CornerRadius="48"
            Padding="8"
            Opacity="1">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
                <Grid x:Name="CollapsedPanel" Width="228" Height="64">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CollapsedMediaVisualizer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <Border Width="2" Height="24" CornerRadius="1" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="CollapsedVisualizerBar1Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                            <Border Width="2" Height="24" CornerRadius="1" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="CollapsedVisualizerBar2Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                            <Border Width="2" Height="24" CornerRadius="1" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="CollapsedVisualizerBar3Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                            <Border Width="2" Height="24" CornerRadius="1" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="CollapsedVisualizerBar4Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                            <Border Width="2" Height="24" CornerRadius="1" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="CollapsedVisualizerBar5Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="36" Height="36" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource IslandSecondaryBrush}" Visibility="{Binding MediaCoverPlaceholderVisibility}" />
                            <Border Width="36" Height="36">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding MediaCover}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle}" Foreground="{StaticResource IslandPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MediaSource}" Foreground="{StaticResource IslandSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="3" Command="{Binding ToggleExpandedCommand}" Content="&#xE70D;" Style="{StaticResource IslandIconButtonStyle}" AutomationProperties.Name="Expand island" />
                    </Grid>
                </Grid>

                <Grid x:Name="ExpandedPanel" Width="500" Height="80" Visibility="Collapsed">
                    <Grid ColumnSpacing="14" Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                            <StackPanel x:Name="MediaVisualizer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                <Border Width="3" Height="34" CornerRadius="2" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="MediaVisualizerBar1Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                                <Border Width="3" Height="34" CornerRadius="2" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="MediaVisualizerBar2Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                                <Border Width="3" Height="34" CornerRadius="2" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="MediaVisualizerBar3Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                                <Border Width="3" Height="34" CornerRadius="2" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="MediaVisualizerBar4Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                                <Border Width="3" Height="34" CornerRadius="2" Background="{StaticResource IslandPrimaryBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="MediaVisualizerBar5Transform" ScaleY="0.03" /></Border.RenderTransform></Border>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Width="44" Height="44" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource IslandSecondaryBrush}" Visibility="{Binding MediaCoverPlaceholderVisibility}" />
                            <Border Width="44" Height="44">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding MediaCover}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle}" Foreground="{StaticResource IslandPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MediaArtist}" Foreground="{StaticResource IslandSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <StackPanel Visibility="{Binding MediaProgressVisibility}" Spacing="2" Margin="0,2,0,0">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding MediaProgressPercent}" Height="2" Foreground="{StaticResource IslandSecondaryBrush}" Background="{StaticResource IslandMutedBrush}" AutomationProperties.Name="Playback progress" />
                                <TextBlock Text="{Binding MediaProgressText}" Foreground="{StaticResource IslandSecondaryBrush}" FontSize="10" />
                            </StackPanel>
                            <TextBlock Text="{Binding PowerText}" Foreground="{StaticResource IslandMutedBrush}" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Column="3" Command="{Binding TogglePlaybackCommand}" Content="{Binding PlaybackGlyph}" Style="{StaticResource IslandIconButtonStyle}" AutomationProperties.Name="Play or pause media" />
                        <Button Grid.Column="4" Command="{Binding ToggleExpandedCommand}" Content="&#xE70D;" Style="{StaticResource IslandIconButtonStyle}" AutomationProperties.Name="Collapse island" />
                    </Grid>
                </Grid>

                <Grid x:Name="AgentPanel" Width="420" MinHeight="72" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12" Margin="0,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AgentIconSurface" Width="44" Height="44" CornerRadius="22" Background="#FF242429">
                                <Image Source="ms-appx:///Assets/agent_icon.png" Width="32" Height="32" Stretch="Uniform" AutomationProperties.Name="Agent notification" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding AgentTitle}" Foreground="{StaticResource IslandPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="2" HorizontalAlignment="Right" Content="&#xE711;" Click="OnDismissNotificationClick" Style="{StaticResource IslandIconButtonStyle}" AutomationProperties.Name="Dismiss notification" />
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="16,0" Text="{Binding AgentQuestion}" Foreground="{StaticResource IslandSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <ItemsControl Grid.Row="2" x:Name="QuestionOptionsList" ItemsSource="{Binding AgentOptions}" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="OnQuestionOptionClick" Style="{StaticResource QuestionOptionButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
